rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/user_roles/$(request.auth.uid))
          .data.isSuperAdmin == true;
    }

    // ── contacts ──────────────────────────────────────────────────
    // Anyone can submit a contact form (create).
    // Only super-admins can read, update, or delete contacts.
    match /contacts/{docId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }

    // ── user_roles ────────────────────────────────────────────────
    // Any signed-in user can read their OWN role document
    // (needed by AuthContext on login).
    // Only super-admins can write role documents.
    match /user_roles/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if isSuperAdmin();
    }

    // ── blog-posts ────────────────────────────────────────────────
    // Anyone can read blog posts.
    // Anyone can update ONLY the views/likes counters (for public interactions).
    // Only super-admins can create, delete, or do full writes.
    match /blog-posts/{docId} {
      allow read: if true;
      allow update: if isSuperAdmin() ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'likes']));
      allow create, delete: if isSuperAdmin();
    }

    // ── comments ──────────────────────────────────────────────────
    // Anyone can read and create comments.
    // Only super-admins can edit or delete comments.
    match /comments/{docId} {
      allow read, create: if true;
      allow update, delete: if isSuperAdmin();
    }

    // ── newsletter & campaigns ────────────────────────────────────
    // Anyone can subscribe (create).
    // Only super-admins can read, update, or delete.
    match /newsletter/{docId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }
    match /newsletter_campaigns/{docId} {
      allow read, write: if isSuperAdmin();
    }

    // ── Deny everything else ──────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}




















