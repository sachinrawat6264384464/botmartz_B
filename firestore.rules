rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper to check authentication
    function isSignedIn() {
      return request.auth != null;
    }

    // ── contacts ──────────────────────────────────────────────────
    match /contacts/{docId} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    // ── partnership_inquiries ─────────────────────────────────────
    match /partnership_inquiries/{docId} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    // ── user_roles ────────────────────────────────────────────────
    match /user_roles/{userId} {
      allow read, write: if true;
    }

    // ── blog-posts ────────────────────────────────────────────────
    match /blog-posts/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // ── case-studies ──────────────────────────────────────────────
    match /case-studies/{docId} {
      allow read, write: if true;
    }

    // ── jobs ──────────────────────────────────────────────────────
    match /jobs/{docId} {
      allow read, write: if true;
    }

    // ── dynamic_pages ──────────────────────────────────────────────
    match /dynamic_pages/{docId} {
      allow read, write: if true;
    }

    // ── labs ──────────────────────────────────────────────────────
    match /labs/{docId} {
      allow read, write: if true;
    }

    // ── projects ──────────────────────────────────────────────────
    match /projects/{docId} {
      allow read, write: if true;
    }

    // ── comments ──────────────────────────────────────────────────
    match /comments/{docId} {
      allow read, create, update, delete: if true;
    }

    // ── newsletter & campaigns ────────────────────────────────────
    match /newsletter/{docId} {
      allow create, read, update, delete: if true;
    }
    match /newsletter_campaigns/{docId} {
      allow read, write: if true;
    }

    // ── job_applications ──────────────────────────────────────────
    match /job_applications/{docId} {
      allow create, read, update, delete: if true;
    }

    // ── site_config ───────────────────────────────────────────────
    match /site_config/{docId} {
      allow read, write: if true;
    }

    // ── events ────────────────────────────────────────────────────
    match /events/{docId} {
      allow read, write: if true;
    }

    // ── event-registrations ───────────────────────────────────────
    match /event-registrations/{docId} {
      allow read, create, update, delete: if true;
    }

    // Catch-all
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
